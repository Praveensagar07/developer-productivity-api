# ========================================================
# Developer Productivity API - Environment Configuration
# ========================================================
# Copy this file to .env for local overrides:
#   copy .env.example .env

# Application Information
APP_NAME=Developer Productivity API
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# API Versioning and Prefix
API_PREFIX=/api/v1

# Server Bind Settings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list of origins)
# For local frontend development (Week 1 React Dashboard)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Data Seeding
# Preload realistic development users, projects, and tasks on application startup
SEED_DATA_ON_STARTUP=true
